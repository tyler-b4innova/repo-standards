#!/usr/bin/env node
// Post the `review` commit status: the pull request's conversation (Codex verdict and threads, evidence for UI
// changes, a promotion's design sign-off), judged by scripts/agent/review.mjs. The org launcher posts it for every
// open pull request each tick; an org without a launcher runs this from its merge helper:
//   scripts/agent/verdict-recheck <pr>... | --all   [--dry-run] [--force]
// GH_TOKEN must be the org App's installation token: the org ruleset pins `review` to the App, so no person's token
// can satisfy it. Nothing is posted for drafts, or while the pack leaves review to gate (--force evaluates, never posts).
// Exit 1 when a status could not be posted.
import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parseArgs } from "node:util";
import { postReviews, restApi } from "./review.mjs";

const { values: o, positionals } = parseArgs({ allowPositionals: true, options: { all: { type: "boolean" }, "dry-run": { type: "boolean" }, force: { type: "boolean" }, help: { type: "boolean" } } });
if (o.help || (!o.all && !positionals.every((p) => /^\d+$/.test(p))) || (!o.all && !positionals.length)) {
  console.log(readFileSync(new URL(import.meta.url), "utf8").split("\n").slice(1, 8).map((l) => l.slice(3)).join("\n"));
  process.exit(o.help ? 0 : 2);
}
const env = process.env, sh = (c, a) => execFileSync(c, a, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
let full = env.GITHUB_REPOSITORY;
if (!full) { try { full = sh("git", ["remote", "get-url", "origin"]).replace(/\.git$/, "").match(/[:/]([^/:]+\/[^/]+)$/)[1]; } catch {} }
if (!full) { console.error("verdict-recheck: no GITHUB_REPOSITORY and no origin remote"); process.exit(2); }
let token = env.GH_TOKEN || env.GITHUB_TOKEN;
try { token ||= sh("gh", ["auth", "token"]); } catch {}
const [owner, repo] = full.split("/"), api = restApi({ token });
const r = await postReviews({ api, owner, repo, prs: positionals.map(Number), all: o.all, dryRun: o["dry-run"], force: o.force, serverUrl: env.GITHUB_SERVER_URL || "https://github.com" });
process.exit(r.failed ? 1 : 0);
