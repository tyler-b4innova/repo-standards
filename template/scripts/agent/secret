#!/usr/bin/env node
// Read secrets from the org's secrets store through its read-only service account, without printing a value.
//   scripts/agent/secret pipe <op://vault/item/field> -- <command> [args...]     the secret on the command's stdin
//   scripts/agent/secret env NAME=<op://...> [NAME=<op://...>...] -- <command> [args...]   those env vars set
//   scripts/agent/secret list [--vault V]          item titles only
//   scripts/agent/secret fields <item> [--vault V]   field labels only
//   scripts/agent/secret check <op://...>          exit 0 if the reference resolves; prints nothing
// No verb prints a value, and the command's own output has the exact value masked as ***. Only the vaults the org
// overlay names are read. The token comes from the org's token file (else the env var) and never reaches the command
// or the output; `op` never falls back to the desktop app. Exit: 2 usage or refused input, 1 failure.
import { spawn, spawnSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { constants, homedir } from "node:os";
import { Transform } from "node:stream";
import { StringDecoder } from "node:string_decoder";

const pack = JSON.parse(readFileSync(new URL("pack.json", import.meta.url), "utf8"));
const cfg = pack.secrets ?? {};
const vaults = [...new Set([cfg.vault_id, ...(cfg.vaults ?? [])].filter(Boolean))];
const tokenVar = cfg.token_env || "OP_SERVICE_ACCOUNT_TOKEN";
let TOKEN = "";
const scrub = (s) => (TOKEN ? String(s).split(TOKEN).join("***") : String(s));
const die = (msg, code = 1) => { console.error(`secret: ${scrub(msg)}`); process.exit(code); };
const usage = (msg) => {
  const help = readFileSync(new URL(import.meta.url), "utf8").split("\n").slice(1).filter((l, i, all) => all.slice(0, i + 1).every((x) => x.startsWith("//"))).map((l) => l.slice(3)).join("\n");
  if (msg) { console.error(`secret: ${msg}\n${help}`); process.exit(2); }
  console.log(help); process.exit(0);
};

const [verb, ...rest] = process.argv.slice(2);
if (!verb || ["-h", "--help", "help"].includes(verb)) usage();
if (!["pipe", "env", "list", "fields", "check"].includes(verb)) usage(`unknown verb "${verb}" (no verb prints a secret's value)`);

// Splits `<args> -- <command...>`; both sides must be non-empty.
function withCommand(args) {
  const at = args.indexOf("--");
  if (at < 1 || at === args.length - 1) usage(`${verb} needs <arguments> -- <command> [args...]`);
  return [args.slice(0, at), args.slice(at + 1)];
}
// `--vault V` or `--vault=V`, the rest positional.
function withVault(args) {
  let vault, pos = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === "--vault") vault = args[++i];
    else if (args[i].startsWith("--vault=")) vault = args[i].slice(8);
    else pos.push(args[i]);
  }
  if (vault !== undefined && !vault) usage("--vault needs a name");
  return [vault, pos];
}
const REF = /^op:\/\/([^/?#]+)\/[^/?#]+\/[^?#]+(\?[A-Za-z0-9_=&.-]+)?$/;
function ref(r) {
  const m = REF.exec(r ?? "");
  if (!m || /[\x00-\x1f]/.test(r) || r.split("?")[0].split("/").some((s) => s === "." || s === "..")) usage(`"${r}" is not an op://<vault>/<item>/<field> reference`);
  if (!vaults.includes(m[1])) usage(`vault "${m[1]}" is not allowed (allowed: ${vaults.join(", ")})`);
  return r;
}

if (cfg.kind !== "1password" || !vaults.length) die("this pack configures no secrets vault (overlay accounts.secrets); nothing to read");

function loadToken() {
  const file = cfg.token_file?.replace(/^~(?=\/)/, homedir());
  if (file && existsSync(file)) {
    for (const line of readFileSync(file, "utf8").split("\n")) {
      const m = line.match(/^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$/);
      if (m?.[1] === tokenVar && m[2]) return m[2].replace(/^(['"])(.*)\1$/, "$2");
    }
    die(`${cfg.token_file} has no ${tokenVar}=<token> line`);
  }
  if (process.env[tokenVar]) return process.env[tokenVar];
  return die(cfg.token_file ? `no service-account token: ${cfg.token_file} does not exist and ${tokenVar} is not set (a person creates the file with one line, ${tokenVar}=<token>)`
    : `no service-account token: set ${tokenVar}`);
}

// op runs with the service-account token and the desktop app switched off, so it fails rather than prompting.
function op(args, what) {
  TOKEN ||= loadToken();
  const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !k.startsWith("OP_")));
  const r = spawnSync("op", args, { env: { ...env, OP_SERVICE_ACCOUNT_TOKEN: TOKEN, OP_BIOMETRIC_UNLOCK_ENABLED: "false" }, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], timeout: 30000, maxBuffer: 1 << 24 });
  if (r.error) die(r.error.code === "ENOENT" ? "the 1Password CLI (op) is not installed" : `op did not run: ${r.error.message}`);
  if (r.status !== 0) die(`could not ${what}: ${(r.stderr || "").trim().split("\n")[0].replace(/^\[ERROR\]\s+[\d/: ]+/, "").slice(0, 200) || `op exited ${r.status}`}`);
  return r.stdout;
}
const read = (r) => op(["read", "--no-newline", r], `read ${r}`);

// Masks the exact secret values in a stream (holding back the longest possible partial match across chunks).
function mask(values) {
  const needles = [...new Set(values.flatMap((v) => [v, v.trim()]))].filter((v) => v.length >= 6).sort((a, b) => b.length - a.length);
  if (!needles.length) return null;
  const hold = needles[0].length - 1, cut = (s) => needles.reduce((t, n) => t.split(n).join("***"), s);
  return () => {
    let tail = "";
    const dec = new StringDecoder("utf8");
    return new Transform({
      transform(chunk, _, cb) { const s = cut(tail + dec.write(chunk)), keep = Math.min(s.length, hold); tail = s.slice(s.length - keep); cb(null, s.slice(0, s.length - keep)); },
      flush(cb) { cb(null, cut(tail + dec.end())); },
    });
  };
}

// The command never sees the token or any OP_ variable. Output is masked; the exit status is the command's.
function run(cmd, extraEnv, input, values) {
  const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !k.startsWith("OP_") && k !== tokenVar));
  const child = spawn(cmd[0], cmd.slice(1), { env: { ...env, ...extraEnv }, stdio: [input === undefined ? "inherit" : "pipe", "pipe", "pipe"] });
  child.on("error", (e) => die(`cannot run ${cmd[0]}: ${e.code === "ENOENT" ? "not found" : e.message}`));
  if (input !== undefined) { child.stdin.on("error", () => {}); child.stdin.end(input); }
  const masker = mask(values);
  for (const [from, to] of [[child.stdout, process.stdout], [child.stderr, process.stderr]]) masker ? from.pipe(masker()).pipe(to) : from.pipe(to);
  child.on("close", (code, sig) => { process.exitCode = code ?? 128 + (constants.signals[sig] ?? 0); });
}

if (verb === "pipe") {
  const [refs, cmd] = withCommand(rest);
  if (refs.length !== 1) usage("pipe takes exactly one op:// reference before --");
  const value = read(ref(refs[0]));
  run(cmd, {}, value, [value]);
} else if (verb === "env") {
  const [pairs, cmd] = withCommand(rest), extra = {};
  for (const p of pairs) {
    const m = /^([A-Z_][A-Z0-9_]*)=(.+)$/.exec(p) ?? usage(`"${p.split("=")[0]}" is not NAME=<op://...> (NAME in capitals)`);
    if (m[1].startsWith("OP_") || m[1] === tokenVar) usage(`${m[1]} is reserved`);
    if (m[1] in extra) usage(`${m[1]} is given twice`);
    extra[m[1]] = ref(m[2]);
  }
  for (const k of Object.keys(extra)) extra[k] = read(extra[k]);
  run(cmd, extra, undefined, Object.values(extra));
} else if (verb === "check") {
  if (rest.length !== 1) usage("check takes one op:// reference");
  read(ref(rest[0]));
} else {
  const [vault = vaults.length === 1 ? vaults[0] : usage(`--vault is required (${vaults.join(", ")})`), pos] = withVault(rest);
  if (!vaults.includes(vault)) usage(`vault "${vault}" is not allowed (allowed: ${vaults.join(", ")})`);
  if (verb === "list") {
    if (pos.length) usage("list takes no item");
    for (const row of JSON.parse(op(["item", "list", "--vault", vault, "--format", "json"], `list ${vault}`) || "[]")) console.log(row.title);
  } else {
    if (pos.length !== 1 || pos[0].startsWith("-")) usage("fields takes one item name");
    const item = JSON.parse(op(["item", "get", pos[0], "--vault", vault, "--format", "json"], `read item ${pos[0]}`));
    for (const label of new Set((item.fields ?? []).map((f) => f.label).filter(Boolean))) console.log(label);
  }
}
