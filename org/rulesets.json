{
  "$comment": "Org-level rulesets every org gets. `org/apply.mjs` renders them with the overlay's `org_admin` (App bypass, strict checks, extra checks, extra restricted and ignored push paths, max file size, an external push ruleset) and owns every organization-level ruleset: names not listed here are deleted on apply. `$`-prefixed strings are overlay placeholders. One branch, `main`: work squash-merges to the default branch, every PR ruleset requires resolved review threads, and code-owner review (the managed CODEOWNERS block for a repo's ui_paths) is required on the default branch and main. Strict status checks (`strict_status_checks`) apply on the squash-merge ruleset (its `gate` rule is always present; only its strict flag follows the overlay). A ruleset's `replaces` names the legacy rulesets it takes over: the first one found is updated in place, and with the overlay's extra-approval setting unset the strictest legacy value is kept.",
  "rulesets": [
    {
      "name": "org: default branch and main (PR + gate)",
      "target": "branch",
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH",
            "refs/heads/main"
          ],
          "exclude": []
        },
        "repository_name": {
          "include": [
            "~ALL"
          ],
          "exclude": [],
          "protected": false
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": true,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true,
            "required_reviewers": [],
            "allowed_merge_methods": [
              "merge",
              "squash"
            ]
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": false,
            "do_not_enforce_on_create": true,
            "required_status_checks": [
              {
                "context": "gate",
                "integration_id": "$gate_integration_id"
              },
              "$extra_checks.default"
            ]
          }
        }
      ]
    },
    {
      "name": "org: squash-merge with code-owner review",
      "replaces": [
        "org: direct repos squash-merge",
        "org: staged main takes promotions (merge commit)",
        "org: staging (PR + gate, squash)"
      ],
      "target": "branch",
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH",
            "refs/heads/main"
          ],
          "exclude": []
        },
        "repository_name": {
          "include": [
            "~ALL"
          ],
          "exclude": [],
          "protected": false
        }
      },
      "rules": [
        {
          "type": "pull_request",
          "parameters": {
            "require_code_owner_review": true,
            "allowed_merge_methods": [
              "squash"
            ]
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": "$strict_status_checks",
            "do_not_enforce_on_create": true,
            "required_status_checks": [
              {
                "context": "gate",
                "integration_id": "$gate_integration_id"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "org: push hygiene (secret files, large files)",
      "target": "push",
      "conditions": {
        "repository_name": {
          "include": [
            "~ALL"
          ],
          "exclude": [],
          "protected": false
        }
      },
      "rules": [
        {
          "type": "file_path_restriction",
          "parameters": {
            "restricted_file_paths": [
              ".env",
              "**/.env",
              ".env*.local",
              "**/.env*.local",
              ".dev.vars",
              "**/.dev.vars",
              "*.pem",
              "**/*.pem",
              "*.p12",
              "**/*.p12",
              "*.key",
              "**/*.key",
              "*.tfvars",
              "**/*.tfvars",
              "$extra_restricted_paths"
            ],
            "ignored_file_paths": [
              "$push_ignored_paths"
            ]
          }
        },
        {
          "type": "max_file_size",
          "parameters": {
            "max_file_size": "$max_file_size_mb"
          }
        }
      ]
    }
  ]
}
