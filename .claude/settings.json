{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent/setup.sh --check",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "allow": [
      "Bash(scripts/agent/pr.sh:*)",
      "Bash(node scripts/agent/evidence.mjs:*)"
    ]
  }
}
