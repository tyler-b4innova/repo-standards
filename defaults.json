{
  "ui_paths": [
    "**/*.{astro,svelte,vue,jsx,tsx,html,css,scss,docx,pptx}",
    "src/{components,layouts,styles,lib/components}/**",
    "{public,static}/**"
  ],
  "ui_ignore": [
    "**/*.{test,spec}.*",
    "{test,tests,e2e}/**",
    "**/*.md",
    ".github/**"
  ],
  "non_deploy_paths": [
    "*.md",
    "docs/**",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/CLAUDE.local.md",
    ".github/ISSUE_TEMPLATE/**",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/CODEOWNERS",
    "LICENSE",
    "LICENSE.*",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".impeccable/**"
  ],
  "source_platforms": [
    "Wix",
    "Squarespace",
    "WordPress",
    "Weebly",
    "GoDaddy",
    "Webflow",
    "Duda",
    "Jimdo"
  ],
  "risk_paths": [
    ".github/workflows/**",
    "**/{auth,oauth,session,sessions}/**",
    "**/auth.{ts,js,mjs}",
    "**/{payments,billing,stripe}/**",
    "**/.env.example",
    "**/.dev.vars.example",
    "**/secrets/**",
    "**/env.{ts,js,mjs}",
    "**/migrations/**",
    "**/wrangler.{toml,json,jsonc}",
    "infra/**",
    ".github/CODEOWNERS",
    "CODEOWNERS",
    "docs/CODEOWNERS",
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/**",
    ".codex/**",
    "scripts/agent/**",
    ".agents/skills/std-*/**",
    "standards.json"
  ],
  "permissions_allow": [],
  "forbidden_files": [
    "CONTEXT.md",
    ".mcp.json"
  ],
  "decision_dirs": [
    "adr",
    "adrs",
    "decisions",
    "decision-records"
  ],
  "orphans": [
    ".agents/skills/std-recall/**",
    "scripts/agent/recall*",
    "scripts/agent/ledger-recall*"
  ],
  "permissions_deny": [
    "Read(~/.ssh/**)",
    "Read(~/.aws/**)",
    "Read(~/.config/**)",
    "Read(**/.env)",
    "Read(**/.env.*)",
    "Read(**/.dev.vars)",
    "Read(**/*.pem)",
    "Bash(op *)",
    "Bash(git push --force *)",
    "Bash(git push -f *)",
    "Bash(git push * --force)",
    "Bash(git push * --force *)",
    "Bash(git push * -f)",
    "Bash(git push * -f *)"
  ],
  "codex_top": {
    "approval_policy": "never",
    "sandbox_mode": "danger-full-access"
  },
  "evidence_trusted_authors": [
    "pr_author",
    "app"
  ],
  "gate_budget": {
    "e2e": 5
  },
  "preview": {
    "check_name": "Workers Builds",
    "check_app": "cloudflare-workers-and-pages",
    "comment_author": "cloudflare-workers-and-pages[bot]"
  }
}
