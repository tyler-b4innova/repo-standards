{
  "limits": {
    "agents": 4096,
    "block": 1800,
    "skill": 1536,
    "pack": 40960
  },
  "ui_paths": [
    "**/*.{astro,svelte,vue,jsx,tsx,html,css,scss,docx,pptx}",
    "src/{components,layouts,styles,lib/components}/**",
    "{public,static}/**"
  ],
  "ui_ignore": [
    "**/*.{test,spec}.*",
    "{test,tests,e2e}/**",
    "**/*.md",
    ".github/**"
  ],
  "models": {
    "claude": {
      "model": "opus",
      "subagent": "opus"
    },
    "codex": {
      "model": "gpt-6-sol",
      "subagent": "gpt-6-sol"
    }
  },
  "permissions_allow": [],
  "forbidden_files": [
    "CONTEXT.md",
    ".mcp.json"
  ],
  "decision_dirs": [
    "adr",
    "adrs",
    "decisions",
    "decision-records"
  ],
  "permissions_deny": [
    "Read(~/.ssh/**)",
    "Read(~/.aws/**)",
    "Read(~/.config/**)",
    "Read(**/.env)",
    "Read(**/.env.*)",
    "Read(**/.dev.vars)",
    "Read(**/*.pem)",
    "Bash(op *)",
    "Bash(git push --force *)",
    "Bash(git push -f *)",
    "Bash(git push * --force)",
    "Bash(git push * --force *)",
    "Bash(git push * -f)",
    "Bash(git push * -f *)"
  ],
  "codex_top": {
    "approval_policy": "never",
    "sandbox_mode": "danger-full-access"
  },
  "evidence_trusted_authors": [
    "pr_author",
    "app"
  ]
}
