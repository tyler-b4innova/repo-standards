{
  "limits": {
    "agents": 4096,
    "block": 1800,
    "skill": 1536,
    "pack": 40960
  },
  "ui_paths": [
    "**/*.{astro,svelte,vue,jsx,tsx,html,css,scss,docx,pptx}",
    "src/{components,layouts,styles,lib/components}/**",
    "{public,static}/**"
  ],
  "ui_ignore": [
    "**/*.{test,spec}.*",
    "{test,tests,e2e}/**",
    "**/*.md",
    ".github/**"
  ],
  "risk_paths": [
    ".github/workflows/**",
    "**/{auth,oauth,session,sessions}/**",
    "**/auth.{ts,js,mjs}",
    "**/{payments,billing,stripe}/**",
    "**/.env.example",
    "**/.dev.vars.example",
    "**/secrets/**",
    "**/env.{ts,js,mjs}",
    "**/migrations/**",
    "**/wrangler.{toml,json,jsonc}",
    "infra/**",
    ".github/CODEOWNERS",
    "CODEOWNERS",
    "docs/CODEOWNERS",
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/**",
    ".codex/**",
    "scripts/agent/**",
    ".agents/skills/std-*/**",
    "standards.json"
  ],
  "permissions_allow": [
    "Bash(scripts/agent/secret:*)"
  ],
  "forbidden_files": [
    "CONTEXT.md",
    ".mcp.json"
  ],
  "decision_dirs": [
    "adr",
    "adrs",
    "decisions",
    "decision-records"
  ],
  "permissions_deny": [
    "Read(~/.ssh/**)",
    "Read(~/.aws/**)",
    "Read(~/.config/**)",
    "Read(**/.env)",
    "Read(**/.env.*)",
    "Read(**/.dev.vars)",
    "Read(**/*.pem)",
    "Bash(op *)",
    "Bash(git push --force *)",
    "Bash(git push -f *)",
    "Bash(git push * --force)",
    "Bash(git push * --force *)",
    "Bash(git push * -f)",
    "Bash(git push * -f *)"
  ],
  "codex_top": {
    "approval_policy": "never",
    "sandbox_mode": "danger-full-access"
  },
  "evidence_trusted_authors": [
    "pr_author",
    "app"
  ],
  "gate_budget": {
    "e2e": 5
  },
  "preview": {
    "check_name": "Workers Builds",
    "comment_author": "cloudflare-workers-and-pages[bot]"
  }
}
